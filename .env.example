# RedTeamAgent — environment template
# Copy to `.env` and fill in real values. NEVER commit .env.

# Required
OPENAI_API_KEY=sk-your-openai-key-here
JWT_SECRET=change-me-generate-a-strong-random-value

# Optional
TOKEN_EXPIRE_HOURS=8
REDTEAM_API_BASE=http://localhost:8000
ALLOWED_ORIGINS=http://localhost:8501
AUTH_DB_PATH=redteam_auth.db

# Seed passwords — change for anything non-local
# SEED_ENGINEER_PW=
# SEED_GOV_PW=
# SEED_ADMIN_PW=
